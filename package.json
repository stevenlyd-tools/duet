{
  "name": "@stevenlyd/duet",
  "version": "0.26.1",
  "private": true,
  "description": "A workflow for two roles working through coding agents: one prototypes ideas, the other engineers the chosen ones for production",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "duet": "src/cli.ts"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run distribution:check && npm run release:check",
    "distribution:generate": "node scripts/distribution.ts --write",
    "distribution:check": "node scripts/distribution.ts --check",
    "release:check": "node scripts/release.mjs check && node --test scripts/test-release.mjs",
    "release:notes": "node scripts/release.mjs notes",
    "release:publish": "node scripts/release.mjs publish",
    "typecheck": "tsc"
  },
  "pi": {
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
